#!/usr/bin/env bash
set -euo pipefail

# This launcher is normally reached through ~/.local/bin/threadbear.
# Resolve the symlink so subcommands still find the scripts next to it.
# THREADBARE_* was the old name for these variables: each stands in for its new name.
for v in $(compgen -e | grep '^THREADBARE_' || true); do n="THREADBEAR_${v#THREADBARE_}"; [ -n "${!n+x}" ] || export "$n=${!v}"; done
SCRIPT_DIR="$(python3 -c 'import os,sys; print(os.path.dirname(os.path.realpath(sys.argv[1])))' "${BASH_SOURCE[0]}")"
APP_DIR="${THREADBEAR_APP_DIR:-$HOME/Applications/Threadbear.app}"

case "${1:-start}" in
  start)
    if [[ ! -d "$APP_DIR" ]]; then
      bash "$SCRIPT_DIR/setup_mac.sh"
    fi
    open "$APP_DIR"
    ;;
  restart)
    exec bash "$SCRIPT_DIR/restart.sh"
    ;;
  mock)
    # Opens the app against the mock runner with a temp data folder.
    shift
    exec bash "$SCRIPT_DIR/Tools/run-mock.sh" "$@"
    ;;
  perf)
    shift
    exec bash "$SCRIPT_DIR/Tools/perf-run.sh" "$@"
    ;;
  stop|kill)
    exec bash "$SCRIPT_DIR/kill.sh"
    ;;
  setup|install)
    exec bash "$SCRIPT_DIR/setup_mac.sh"
    ;;
  *)
    echo "Usage: threadbear [start|restart|mock|perf|stop|setup]" >&2
    exit 2
    ;;
esac
